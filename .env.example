 GROQ_MODEL=openai/gpt-oss-20b

# Multiple Groq API Keys (Comma-separated for round-robin rotation)
GROQ_KEY_1=gsk_key1_
GROQ_KEY_2=gsk_key2_
GROQ_KEY_3=gsk_key3_


# LangSmith Tracing for Workflow & Node Visualization
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=stylesync-ai-agent
LANGSMITH_ENDPOINT=https://api.smith.langchain.com